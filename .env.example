# Neon Serverless Postgres Connection String (pooled recommended for Vercel/serverless)
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Make.com Webhook Ingestion API Security Key
INGESTION_API_KEY=b2b_music_secure_ingest_key_change_me_in_prod

# On-Demand ISR Revalidation Secret
REVALIDATION_SECRET=revalidate_secret_key_change_me

# Brevo (Sendinblue) Transactional Email API Key
BREVO_API_KEY=xkeysib-sample-key
BREVO_SENDER_EMAIL=licensing@b2bproductionmusic.com
BREVO_SENDER_NAME=B2B Production Music
BREVO_ADMIN_EMAIL=admin@b2bproductionmusic.com

# Stripe Payments Configuration
STRIPE_SECRET_KEY=sk_test_sample
STRIPE_WEBHOOK_SECRET=whsec_sample
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sample

# Site Canonical URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
