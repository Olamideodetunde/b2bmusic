# ─────────────────────────────────────────────────────────────────────
# GlobalB2BAudioHolding.com — environment variables
# Copy to .env.local for development. In Vercel, set these per environment
# (Production / Preview) under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────

# Public site origin — used for canonical URLs, sitemap, Live URL write-back, Stripe redirects.
NEXT_PUBLIC_SITE_URL=https://globalb2baudioholding.com

# Public contact / licensing address shown on the site (footer, pricing, enterprise CTAs).
# Brand name, domain and logo paths live in src/lib/brand.ts.
NEXT_PUBLIC_CONTACT_EMAIL=licensing@globalb2baudioholding.com

# Staging on a non-Vercel host (e.g. Railway): set NOINDEX=true so search engines never
# index it. On Vercel, Preview deployments are noindex automatically (VERCEL_ENV).
# NOINDEX=true

# ── Database (Neon Postgres) ─────────────────────────────────────────
# Use the POOLED connection string for the app (host contains "-pooler").
# Leave unset in development to use the local JSON store in .data/.
# Staging and production should be separate Neon branches.
DATABASE_URL=

# ── Make.com → API authentication ────────────────────────────────────
# Long random secret (≥ 24 chars). Make.com sends it as "Authorization: Bearer <key>".
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INGESTION_API_KEY=
# (Legacy alias still accepted: INGEST_API_KEY.)

# Secret for POST /api/revalidate (manual cache refresh). The ingestion key is accepted there too.
REVALIDATION_SECRET=

# HEAD-check each Audio URL before publishing (recommended). Set to false to skip.
AUDIO_URL_CHECK=true

# ── Stripe (checkout) ────────────────────────────────────────────────
# Use sk_test_… on staging and sk_live_… on production.
STRIPE_SECRET_KEY=
# From Stripe → Developers → Webhooks → your endpoint (…/api/stripe/webhook) → Signing secret.
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         customer.subscription.created/updated/deleted, charge.refunded
STRIPE_WEBHOOK_SECRET=

# All-access subscription: the recurring price_… id. The site reads the amount from Stripe.
# Leave empty to hide subscriptions (the unlock modal then shows "launching soon").
STRIPE_SUBSCRIPTION_PRICE_ID=

# ── Accounts (magic-link sign-in) ────────────────────────────────────
# ≥ 32 random chars. Signs session cookies and receipt download links; rotating it signs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ── Audio storage (Amazon S3 or Backblaze B2) — see docs/audio-and-access.md ──
# Masters bucket is PRIVATE (WAV/AIFF, served only via /api/download). Previews bucket is public.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# Backblaze B2 only, e.g. https://s3.us-west-004.backblazeb2.com (leave empty for Amazon S3)
S3_ENDPOINT=
S3_MASTERS_BUCKET=
S3_PREVIEWS_BUCKET=
# Public base URL of the previews bucket or the CDN in front of it (no trailing slash)
PREVIEW_PUBLIC_BASE_URL=
# Fair-use cap on master downloads per user per 24 h (anti-scraping). 0 = no cap.
DOWNLOAD_DAILY_LIMIT=150

# ── Watermark pipeline (npm run audio:watermark) ─────────────────────
# Your voice ident / sound, mixed into every preview every 12 s. Empty = built-in chime.
# WATERMARK_FILE=./ident.wav
# FFmpeg defaults to the ffmpeg-static package; override with a system build if needed.
# FFMPEG_PATH=

# ── Brevo (transactional email) ──────────────────────────────────────
BREVO_API_KEY=
# Must be an address on the domain verified in Brevo.
BREVO_SENDER_EMAIL=licensing@globalb2baudioholding.com
BREVO_SENDER_NAME=Global B2B Audio Holding
# Who receives "published" / "publish error" alerts.
BREVO_ADMIN_EMAIL=
# (Legacy alias still accepted: BREVO_ALERT_EMAIL.)
# Set to false to stop emails for rejected rows (the sheet still shows Status = Error).
BREVO_ALERT_ON_ERROR=true

# ── Images ───────────────────────────────────────────────────────────
# Extra hosts whose Cover Image URLs are resized/optimized by next/image (comma-separated).
# images.unsplash.com is built in. Covers on other hosts still show, just unoptimized.
# NEXT_PUBLIC_IMAGE_HOSTS=cdn.example.com,pub-xxxx.r2.dev

# ── Local testing only ───────────────────────────────────────────────
# Allows the JSON store under `next start` (production mode) for local end-to-end tests.
# Never set this on Vercel.
# ALLOW_FILE_STORE=true
# Path of the local JSON store (default .data/local-db.json). The test suite sets this.
# LOCAL_DB_PATH=
