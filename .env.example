# ─────────────────────────────────────────────────────────────────────
# B2BProductionMusic.com — environment variables
# Copy to .env.local for development. In Vercel, set these per environment
# (Production / Preview) under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────

# Public site origin — used for canonical URLs, sitemap, Live URL write-back, Stripe redirects.
NEXT_PUBLIC_SITE_URL=https://b2bproductionmusic.com

# ── Database (Neon Postgres) ─────────────────────────────────────────
# Use the POOLED connection string for the app (host contains "-pooler").
# Leave unset in development to use the local JSON store in .data/.
# Staging and production should be separate Neon branches.
DATABASE_URL=

# ── Make.com → API authentication ────────────────────────────────────
# Long random secret (≥ 24 chars). Make.com sends it as "Authorization: Bearer <key>".
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INGESTION_API_KEY=

# Secret for POST /api/revalidate (manual cache refresh). The ingestion key is accepted there too.
REVALIDATION_SECRET=

# HEAD-check each Audio URL before publishing (recommended). Set to false to skip.
AUDIO_URL_CHECK=true

# ── Stripe (checkout) ────────────────────────────────────────────────
# Use sk_test_… on staging and sk_live_… on production.
STRIPE_SECRET_KEY=
# From Stripe → Developers → Webhooks → your endpoint (…/api/stripe/webhook) → Signing secret.
STRIPE_WEBHOOK_SECRET=

# ── Brevo (transactional email) ──────────────────────────────────────
BREVO_API_KEY=
# Must be an address on the domain verified in Brevo.
BREVO_SENDER_EMAIL=licensing@b2bproductionmusic.com
BREVO_SENDER_NAME=B2B Production Music
# Who receives "published" / "publish error" alerts.
BREVO_ADMIN_EMAIL=
# Set to false to stop emails for rejected rows (the sheet still shows Status = Error).
BREVO_ALERT_ON_ERROR=true

# ── Local testing only ───────────────────────────────────────────────
# Allows the JSON store under `next start` (production mode) for local end-to-end tests.
# Never set this on Vercel.
# ALLOW_FILE_STORE=true
